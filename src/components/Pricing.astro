---
// src/components/Pricing.astro
const STRIPE_PK = "pk_live_51UBvOaKVTuotmD6yO7x9kSewlU7y1CjP8eN2nrSVQvgicr1TNmf7kdB2IjAHHaKiaORIpGZ77dW8awW58eVYfR43000IWVRq37";

const SEATPRUNE = {
  buyButtonId: "buy_btn_1UE4xIKVTuotmD6ymy8wYiam",
  paymentLink: "https://buy.stripe.com/seatprune",
};

const HEALWRIGHT = {
  buyButtonId: "buy_btn_1UE4uiKVTuotmD6yTUdtV1rc",
  paymentLink: "https://buy.stripe.com/healwright",
};
---

<section id="pricing" class="scroll-mt-24 py-20 px-4 max-w-5xl mx-auto">
  <div class="text-center mb-16">
    <h2 class="text-xs uppercase tracking-widest text-cyan-400 font-semibold mb-3">Pricing</h2>
    <p class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
      Production Developer Tooling
    </p>
    <p class="mt-4 text-base text-slate-400 max-w-xl mx-auto">
      Local-first, zero DOM egress. Built on FastMCP with instant CI/CD deployment.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
    <!-- SeatPrune Pro -->
    <div class="flex flex-col justify-between p-8 rounded-2xl border border-slate-800 bg-slate-900/60 backdrop-blur">
      <div>
        <span class="text-xs font-semibold px-2.5 py-1 rounded bg-slate-800 text-cyan-400">FinOps Agent</span>
        <h3 class="text-2xl font-bold text-white mt-4">SeatPrune Pro</h3>
        <p class="text-sm text-slate-400 mt-2">Automated SaaS license reclamation across GitHub, Slack & Jira.</p>
        
        <div class="mt-6 mb-8 flex items-baseline">
          <span class="text-4xl font-extrabold text-white">€19.00</span>
          <span class="text-sm text-slate-500 ml-2">/ month</span>
        </div>

        <ul class="space-y-3 text-sm text-slate-300">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            GitHub, Slack & Jira connectors
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Automated dry-run audit reports
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Scheduled GitHub Actions workflows
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Zero data egress (100% local execution)
          </li>
        </ul>
      </div>

      <div class="mt-8 space-y-4">
        <!-- Stripe Buy Button -->
        <div class="min-h-[44px] flex items-center justify-center">
          <stripe-buy-button
            buy-button-id={SEATPRUNE.buyButtonId}
            publishable-key={STRIPE_PK}
          >
          </stripe-buy-button>
        </div>

        <!-- Mobile QR Code Drawer -->
        <details class="text-center group border-t border-slate-800/80 pt-3">
          <summary class="text-xs text-slate-400 hover:text-cyan-400 cursor-pointer select-none transition">
            📱 Pay with mobile QR code
          </summary>
          <div class="mt-3 p-3 bg-white rounded-lg inline-block shadow-lg">
            <img 
              src={`https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=${encodeURIComponent(SEATPRUNE.paymentLink)}`} 
              alt="Scan to pay SeatPrune Pro via Stripe" 
              class="w-32 h-32 mx-auto"
              loading="lazy"
            />
            <p class="text-[10px] text-slate-700 mt-1 font-sans">Apple Pay / Google Pay</p>
          </div>
        </details>
      </div>
    </div>

    <!-- Healwright (Featured) -->
    <div class="flex flex-col justify-between p-8 rounded-2xl border-2 border-cyan-500/80 bg-slate-900/90 relative shadow-2xl shadow-cyan-950/40">
      <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 bg-cyan-500 text-slate-950 font-bold text-xs rounded-full uppercase tracking-wide">
        Most Popular
      </div>

      <div>
        <span class="text-xs font-semibold px-2.5 py-1 rounded bg-cyan-950 text-cyan-300">Playwright QA</span>
        <h3 class="text-2xl font-bold text-white mt-4">Healwright</h3>
        <p class="text-sm text-slate-400 mt-2">Ephemeral self-healing locators with local FastMCP intelligence.</p>
        
        <div class="mt-6 mb-8 flex items-baseline">
          <span class="text-4xl font-extrabold text-white">€29.00</span>
          <span class="text-sm text-slate-500 ml-2">/ month</span>
        </div>

        <ul class="space-y-3 text-sm text-slate-300">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Auto-healing test locators
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Zero DOM egress (Runs 100% locally)
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Self-updating test branch PRs
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Pre-built FastMCP binary distribution
          </li>
        </ul>
      </div>

      <div class="mt-8 space-y-4">
        <!-- Stripe Buy Button -->
        <div class="min-h-[44px] flex items-center justify-center">
          <stripe-buy-button
            buy-button-id={HEALWRIGHT.buyButtonId}
            publishable-key={STRIPE_PK}
          >
          </stripe-buy-button>
        </div>

        <!-- Mobile QR Code Drawer -->
        <details class="text-center group border-t border-slate-800/80 pt-3">
          <summary class="text-xs text-slate-400 hover:text-cyan-400 cursor-pointer select-none transition">
            📱 Pay with mobile QR code
          </summary>
          <div class="mt-3 p-3 bg-white rounded-lg inline-block shadow-lg">
            <img 
              src={`https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=${encodeURIComponent(HEALWRIGHT.paymentLink)}`} 
              alt="Scan to pay Healwright via Stripe" 
              class="w-32 h-32 mx-auto"
              loading="lazy"
            />
            <p class="text-[10px] text-slate-700 mt-1 font-sans">Apple Pay / Google Pay</p>
          </div>
        </details>
      </div>
    </div>
  </div>

  <!-- Stripe Buy Button Script (is:inline prevents Astro bundling issues) -->
  <script is:inline async src="https://js.stripe.com/v3/buy-button.js"></script>
</section>
