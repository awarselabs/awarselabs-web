---
// Pricing.astro - Awarse Labs Developer Tools Pricing
---

<section id="pricing" class="py-20 px-4 max-w-7xl mx-auto scroll-mt-20">
  <div class="text-center mb-16">
    <h2 class="text-xs uppercase tracking-widest text-cyan-400 font-semibold mb-3">Transparent Billing</h2>
    <p class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
      Developer Tooling Built for Scale
    </p>
    <p class="mt-4 text-base text-slate-400 max-w-2xl mx-auto">
      Local-first, privacy-preserving agents. Zero cloud lock-in, deploy in minutes.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
    <!-- Tier 1: Community / OSS -->
    <div class="flex flex-col justify-between p-8 rounded-2xl border border-slate-800 bg-slate-900/50 backdrop-blur">
      <div>
        <span class="text-xs font-semibold px-2.5 py-1 rounded bg-slate-800 text-slate-300">Community</span>
        <h3 class="text-2xl font-bold text-white mt-4">Open Source</h3>
        <p class="text-sm text-slate-400 mt-2">Self-hosted local CLI and core FastMCP runner.</p>
        
        <div class="mt-6 mb-8 flex items-baseline">
          <span class="text-4xl font-extrabold text-white">€0</span>
          <span class="text-sm text-slate-500 ml-2">/ forever</span>
        </div>

        <ul class="space-y-3 text-sm text-slate-300">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Local FastMCP execution
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Community Discord & GitHub support
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Single-seat local runner
          </li>
        </ul>
      </div>

      <div class="mt-8">
        <a 
          href="/docs" 
          class="block w-full text-center py-2.5 px-4 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-medium text-sm transition"
        >
          Read Documentation
        </a>
      </div>
    </div>

    <!-- Tier 2: SeatPrune Pro -->
    <div class="flex flex-col justify-between p-8 rounded-2xl border border-slate-800 bg-slate-900/60 backdrop-blur">
      <div>
        <span class="text-xs font-semibold px-2.5 py-1 rounded bg-slate-800 text-cyan-400">FinOps Agent</span>
        <h3 class="text-2xl font-bold text-white mt-4">SeatPrune Pro</h3>
        <p class="text-sm text-slate-400 mt-2">Automated SaaS license reclamation across GitHub & Slack.</p>
        
        <div class="mt-6 mb-8 flex items-baseline">
          <span class="text-4xl font-extrabold text-white">€19</span>
          <span class="text-sm text-slate-500 ml-2">/ month</span>
        </div>

        <ul class="space-y-3 text-sm text-slate-300">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            GitHub, Slack & Jira connectors
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Automated dry-run audit reports
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Scheduled GitHub Actions workflows
          </li>
        </ul>
      </div>

      <div class="mt-8 space-y-3">
        <!-- Stripe Buy Button for SeatPrune Pro -->
        <!-- Replace buy-button-id and publishable-key with live Stripe credentials -->
        <stripe-buy-button
          buy-button-id="BUY_BUTTON_ID_SEATPRUNE"
          publishable-key="pk_live_YOUR_PUBLISHABLE_KEY"
        >
        </stripe-buy-button>

        <!-- QR Code Drawer Trigger -->
        <details class="text-center group">
          <summary class="text-xs text-slate-400 hover:text-cyan-400 cursor-pointer select-none transition">
            📱 Pay with mobile QR code
          </summary>
          <div class="mt-3 p-3 bg-white rounded-lg inline-block shadow-lg">
            <img 
              src="https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=https://buy.stripe.com/YOUR_SEATPRUNE_PAYMENT_LINK" 
              alt="Scan to pay SeatPrune Pro via Stripe" 
              class="w-32 h-32 mx-auto"
              loading="lazy"
            />
            <p class="text-[10px] text-slate-700 mt-1 font-sans">Apple Pay / Google Pay</p>
          </div>
        </details>
      </div>
    </div>

    <!-- Tier 3: Healwright (Featured) -->
    <div class="flex flex-col justify-between p-8 rounded-2xl border-2 border-cyan-500/80 bg-slate-900/90 relative shadow-2xl shadow-cyan-950/40">
      <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 bg-cyan-500 text-slate-950 font-bold text-xs rounded-full uppercase tracking-wide">
        Most Popular
      </div>

      <div>
        <span class="text-xs font-semibold px-2.5 py-1 rounded bg-cyan-950 text-cyan-300">Playwright QA</span>
        <h3 class="text-2xl font-bold text-white mt-4">Healwright</h3>
        <p class="text-sm text-slate-400 mt-2">Ephemeral self-healing locators with FastMCP intelligence.</p>
        
        <div class="mt-6 mb-8 flex items-baseline">
          <span class="text-4xl font-extrabold text-white">€29</span>
          <span class="text-sm text-slate-500 ml-2">/ month</span>
        </div>

        <ul class="space-y-3 text-sm text-slate-300">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Auto-healing test locators
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Zero DOM egress (Runs 100% locally)
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Self-updating test branch PRs
          </li>
        </ul>
      </div>

      <div class="mt-8 space-y-3">
        <!-- Stripe Buy Button for Healwright -->
        <!-- Replace buy-button-id and publishable-key with live Stripe credentials -->
        <stripe-buy-button
          buy-button-id="BUY_BUTTON_ID_HEALWRIGHT"
          publishable-key="pk_live_YOUR_PUBLISHABLE_KEY"
        >
        </stripe-buy-button>

        <!-- QR Code Drawer Trigger -->
        <details class="text-center group">
          <summary class="text-xs text-slate-400 hover:text-cyan-400 cursor-pointer select-none transition">
            📱 Pay with mobile QR code
          </summary>
          <div class="mt-3 p-3 bg-white rounded-lg inline-block shadow-lg">
            <img 
              src="https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=https://buy.stripe.com/YOUR_HEALWRIGHT_PAYMENT_LINK" 
              alt="Scan to pay Healwright via Stripe" 
              class="w-32 h-32 mx-auto"
              loading="lazy"
            />
            <p class="text-[10px] text-slate-700 mt-1 font-sans">Apple Pay / Google Pay</p>
          </div>
        </details>
      </div>
    </div>
  </div>

  <!-- Stripe Buy Button Script -->
  <script is:inline async src="https://js.stripe.com/v3/buy-button.js"></script>
</section>
