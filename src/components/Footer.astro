---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-800/80 bg-slate-950 text-slate-400 text-xs mt-24">
  <div class="max-w-7xl mx-auto px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      
      <!-- Col 1: Brand & Tagline -->
      <div class="md:col-span-2 space-y-3">
        <div class="text-sm font-semibold text-white tracking-wider uppercase">Awarse Labs</div>
        <p class="text-slate-400 max-w-sm leading-relaxed">
          Local-first developer tooling and FastMCP agents for Playwright QA self-healing (Healwright) and FinOps SaaS seat reclamation (SeatPrune).
        </p>
        <p class="text-[11px] text-slate-500">
          Zero DOM egress. Runs 100% on your local runtime or private CI.
        </p>
      </div>

      <!-- Col 2: Navigation / Product Links -->
      <div>
        <div class="text-slate-200 font-medium mb-3">Products & Docs</div>
        <ul class="space-y-2">
          <li><a href="/docs/healwright/playwright-self-healing-locators" class="hover:text-cyan-400 transition">Healwright</a></li>
          <li><a href="/docs/seatprune/quickstart" class="hover:text-cyan-400 transition">SeatPrune</a></li>
          <li><a href="/docs" class="hover:text-cyan-400 transition">Documentation</a></li>
          <li><a href="/#pricing" class="hover:text-cyan-400 transition">Pricing</a></li>
          <li><a href="https://github.com/awarselabs/awarse-mcp" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition">GitHub Repo</a></li>
        </ul>
      </div>

      <!-- Col 3: Legal & Statutory -->
      <div>
        <div class="text-slate-200 font-medium mb-3">Legal & Compliance</div>
        <ul class="space-y-2">
          <li><a href="/legal/terms" class="hover:text-cyan-400 transition">Terms of Service</a></li>
          <li><a href="/legal/privacy" class="hover:text-cyan-400 transition">Privacy Policy</a></li>
          <li><a href="mailto:support@awarselabs.com" class="hover:text-cyan-400 transition">Contact & Support</a></li>
        </ul>
      </div>
    </div>

    <!-- Statutory Irish Business Disclosure Bar -->
    <div class="border-t border-slate-900 pt-8 mt-8 text-[11px] text-slate-500 space-y-2 leading-relaxed">
      <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-2">
        <p>© {currentYear} Awarse Labs. All rights reserved.</p>
        <p class="text-slate-400">
          Awarse Labs is a registered business name in Ireland (CRO No. 793328).
        </p>
      </div>
      
      <!-- Statutory Details Required by Irish e-Commerce Regulations -->
      <p class="text-slate-500">
        Registered in Ireland under the Registration of Business Names Act, 1963. 
        Individual Proprietor: <span class="text-slate-400">Sean Kildunne</span> · 
        Place of Registration: Dublin, Ireland · 
        Contact: <a href="mailto:support@awarselabs.com" class="underline hover:text-slate-300">support@awarselabs.com</a>
      </p>
    </div>
  </div>
</footer>
